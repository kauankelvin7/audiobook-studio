{
  "name": "audiobook-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "predev": "node scripts/stage-tts-runtime.mjs && node scripts/stage-ocr-runtime.mjs",
    "dev": "vite",
    "prebuild": "node scripts/stage-tts-runtime.mjs && node scripts/stage-ocr-runtime.mjs",
    "build": "tsc -b && vite build",
    "wasm:build": "node ../../scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run src/adapters/local_project_persistence.test.ts src/adapters/review_submission_persistence.test.ts src/adapters/indexeddb_checkpoint_repository.test.ts src/adapters/opfs_artifact_store.test.ts src/adapters/web_locks_project_lock.test.ts",
    "test:browser:audio": "node scripts/smoke-literal-audio.mjs",
    "test:browser:ocr-crop": "node scripts/smoke-ocr-crop.mjs",
    "test:browser:local-ocr": "node scripts/stage-ocr-runtime.mjs && node scripts/smoke-local-ocr.mjs",
    "test:browser:ocr-review-ui": "node scripts/stage-ocr-runtime.mjs && node scripts/smoke-ocr-review-ui.mjs",
    "test:browser:scanned-ocr": "node scripts/stage-ocr-runtime.mjs && node scripts/smoke-scanned-page-ocr.mjs",
    "test:browser:ocr-learning": "node scripts/stage-ocr-runtime.mjs && node scripts/smoke-ocr-learning.mjs",
    "test:standard": "npm run typecheck && npm test && npm run build",
    "test:full": "npm run test:standard && npm audit --audit-level=high"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@tesseract.js-data/por": "1.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "onnxruntime-web": "1.18.0",
    "pdfjs-dist": "5.4.296",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "7.0.0",
    "typescript": "5.6.3",
    "vite": "8.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "fake-indexeddb": "6.2.5",
    "playwright-core": "1.63.0",
    "vitest": "5.0.1"
  }
}
