{
  "name": "audiobook-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "wasm:build": "node ../../scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run src/adapters/local_project_persistence.test.ts src/adapters/indexeddb_checkpoint_repository.test.ts src/adapters/opfs_artifact_store.test.ts src/adapters/web_locks_project_lock.test.ts",
    "test:standard": "npm run typecheck && npm test && npm run build",
    "test:full": "npm run test:standard && npm audit --audit-level=high"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "pdfjs-dist": "5.4.296",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "8.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "fake-indexeddb": "6.2.5",
    "vitest": "5.0.1"
  }
}
